# dependencies
node_modules
.pnpm-store
.pnp
.pnp.*

# build outputs
dist
build
.next
out
*.tsbuildinfo
next-env.d.ts

# generated
**/registry.generated.ts
**/manifests.generated.ts

# coverage / test
coverage
test-results
playwright-report
# CI reports and failure records (uploaded as workflow artifacts)
/reports/

# env
.env
.env.*
!.env.example
# `pnpm dev`'s defaults: read-only from config/. No secrets.
!apps/web/.env.development

# personal portfolio data — like .env, never commit your own values. Use
# portfolio.example.yml as the starting point and copy it into config/.
/config/*
!/config/.gitkeep
/portfolio.yml
/portfolio.yaml

# editor
.vscode
.idea

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# misc
*.pem
.cache
.impeccable/

# variant experiments — gitignored holding pen for non-curated variant candidates
/experiments/

# visual companion preview screenshots — generated locally by skills/variant-developer
/.variant-preview/

# archive of the prior single-app project state — local reference only
/archive/
