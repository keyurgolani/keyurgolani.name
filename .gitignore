# dependencies
node_modules
.pnpm-store
.pnp
.pnp.*

# build outputs
dist
build
.next
out
*.tsbuildinfo
next-env.d.ts

# generated: what `pnpm --filter @portfolio/web build:registry` writes (#5),
# the appearance packs' compiled files it writes beside them (#19), and the
# variants' compiled stylesheets with the images they name (#6)
apps/web/src/lib/generated/
apps/web/public/_portfolio/pack/
apps/web/public/_portfolio/variant/
apps/web/public/_portfolio/asset/

# coverage / test
coverage
test-results
playwright-report
# CI reports and failure records (uploaded as workflow artifacts)
/reports/

# env
.env
.env.*
!.env.example

# Deployment secrets, such as the owner password hash in deploy/secrets/.
# None is ever committed (#2).
secrets/
# `pnpm dev`'s owner data directory (#3): sessions, drafts, and revisions.
/.data/
# `pnpm dev`'s defaults: read-only from config/. No secrets.
!apps/web/.env.development

# personal portfolio data: like .env, never commit your own values. Copy
# portfolio.example.yml and site.example.yml into config/ and edit them there.
# Ignore files don't expand braces, so each of the six names has its line.
/config/*
!/config/.gitkeep
/portfolio.yml
/portfolio.yaml
/portfolio.json
/site.yml
/site.yaml
/site.json

# editor
.vscode
.idea

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# misc
*.pem
.cache
.impeccable/

# variant experiments — gitignored holding pen for non-curated variant candidates
/experiments/

# archive of the prior single-app project state — local reference only
/archive/
