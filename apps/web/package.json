{
  "name": "@portfolio/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:registry": "tsx scripts/build-registry.ts",
    "build:store": "pnpm build:registry --modules-only && node scripts/bundle-store.mjs",
    "check:variants": "tsx scripts/check-variants.ts",
    "check:appearance": "tsx scripts/check-appearance.ts",
    "predev": "pnpm build:registry",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "pnpm build:registry",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "pnpm build:registry --modules-only && tsc --noEmit",
    "test": "pnpm build:registry --modules-only && tsx --conditions=react-server --test 'src/**/*.test.ts' && tsx --import ./scripts/server-only.cjs --test 'src/**/*.test.tsx' 'scripts/**/*.test.ts' && node --test 'scripts/**/*.test.mjs' 'bin/**/*.test.mjs'",
    "test:profiles": "node ../../ci/test-profiles.mjs",
    "test:security": "node ../../ci/test-security.mjs",
    "test:security:proxy": "node ../../ci/test-security-proxy.mjs"
  },
  "dependencies": {
    "@portfolio/appearance": "workspace:*",
    "@portfolio/appearance-fixtures-languages": "workspace:*",
    "@portfolio/appearance-fixtures-schemes": "workspace:*",
    "@portfolio/appearance-fixtures-typography": "workspace:*",
    "@portfolio/appearance-languages": "workspace:*",
    "@portfolio/appearance-schemes": "workspace:*",
    "@portfolio/appearance-typography": "workspace:*",
    "@portfolio/core": "workspace:*",
    "@portfolio/fallback-composition": "workspace:*",
    "@portfolio/fixture-over-budget": "workspace:*",
    "@portfolio/fixture-type-font": "workspace:*",
    "@portfolio/fixture-variant-light": "workspace:*",
    "@portfolio/fixture-variant-medium": "workspace:*",
    "@portfolio/kit": "workspace:*",
    "@portfolio/preview-fixtures": "workspace:*",
    "@portfolio/quality-fixtures-languages": "workspace:*",
    "@portfolio/quality-fixtures-schemes": "workspace:*",
    "@portfolio/quality-fixtures-schemes-meta": "workspace:*",
    "@portfolio/quality-fixtures-typography": "workspace:*",
    "@portfolio/schema": "workspace:*",
    "@portfolio/variant-contract": "workspace:*",
    "@portfolio/variant-editorial-evidence": "workspace:*",
    "@portfolio/variant-horizontal-cinema": "workspace:*",
    "@portfolio/variant-kinetic-cosmos": "workspace:*",
    "@portfolio/variant-obsidian-atelier": "workspace:*",
    "@portfolio/variant-spatial-bento": "workspace:*",
    "next": "16.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
