{
  "name": "@portfolio/web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build:registry": "tsx scripts/build-registry.ts",
    "check:variants": "tsx scripts/check-variants.ts",
    "predev": "pnpm build:registry",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "pnpm build:registry",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "pnpm build:registry && tsc --noEmit",
    "test": "pnpm build:registry && tsx --conditions=react-server --test 'src/**/*.test.ts' && tsx --test 'src/**/*.test.tsx' && node --test 'scripts/**/*.test.mjs' 'bin/**/*.test.mjs'",
    "test:profiles": "node ../../ci/test-profiles.mjs",
    "test:security": "node ../../ci/test-security.mjs"
  },
  "dependencies": {
    "@portfolio/core": "workspace:*",
    "@portfolio/fallback-composition": "workspace:*",
    "@portfolio/kit": "workspace:*",
    "@portfolio/schema": "workspace:*",
    "@portfolio/variant-contract": "workspace:*",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
