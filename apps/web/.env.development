# Loaded by `next dev` only. A fresh clone's `pnpm dev` finds neither document
# in config/ and renders the bundled examples. Put your portfolio.yml and
# site.yml in config/.
# Every deployment key is listed in /.env.example.
PORTFOLIO_PROFILE=read-only
PORTFOLIO_ORIGIN=http://127.0.0.1:3000
PORTFOLIO_SOURCE_DIR=../../config
