{
  "name": "landing-large-text-phones-final",
  "summary": "Thirteen compositions keep a phone's pages inside the window at 200% text, folds open or shut, print leaves the Appearance controls off the page, and the variants parity read keeps its page, all at once",
  "head": "fbcca256b36759fefddecb832156113c9f115521",
