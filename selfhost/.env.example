# Copy this file to .env beside compose.yml and set PORTFOLIO_ORIGIN. Docker
# Compose reads .env from the folder it runs in. Nothing here is secret, and
# no secret belongs in .env: the owner profile reads its password hash from
# secrets/owner_password_hash, a file (docs/self-hosting.md).

# Required. The origin visitors use: scheme, host, and optional port, with no
# path or trailing slash. https unless it's loopback.
PORTFOLIO_ORIGIN=https://jane.name

# The port on 127.0.0.1 the proxy on this host reaches the server at.
PORT=3000

# The owner profile only: how many proxies in front append X-Forwarded-For,
# usually 1 behind one reverse proxy.
PORTFOLIO_TRUSTED_PROXY_HOPS=1

# The Compose files run release 1.0.0, pinned by its digest. To follow every
# 1.x release instead, uncomment:
# PORTFOLIO_IMAGE=ghcr.io/keyurgolani/portfolio:1
