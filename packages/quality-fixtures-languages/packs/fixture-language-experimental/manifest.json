{
  "id": "fixture-language-experimental",
  "name": "Fixture Language Experimental",
  "description": "A tier fixture: an Experimental design language with hard offset shadows, ink-colored borders, springy motion, and a stylesheet of its own, for the quality gates to run as a shipping Experimental pack.",
  "tokenContract": 1,
  "tier": "experimental",
  "provenance": {
    "source": {
      "name": "Keyur Golani portfolio platform"
    },
    "license": "first-party",
    "researchedAt": "2026-10-22",
    "maintainer": "keyurgolani",
    "derivation": "platform-neutral with 4px radii, 2px borders in text-primary, solid 4px offset shadows, a nudging hover, spring and bounce motion, and a stylesheet that marks the focused surface.",
    "caveats": [
      "A test fixture: it registers only when QUALITY_FIXTURES is 1 or meta.",
      "Its stylesheet adds CSS a shipping pack might not need."
    ]
  },
  "stylesheet": "./styles.css",
  "tokens": {
    "surface-material": "linear-gradient(var(--color-surface-default), var(--color-surface-default))",
    "surface-opacity": "100%",
    "radius-control": "4px",
    "radius-card": "4px",
    "radius-overlay": "6px",
    "radius-media": "4px",
    "radius-badge": "999px",
    "border-control": "2px solid var(--color-text-primary)",
    "border-card": "2px solid var(--color-text-primary)",
    "border-divider": "1px solid var(--color-border-subtle)",
    "shadow-card": "4px 4px 0 var(--color-text-primary)",
    "shadow-overlay": "6px 6px 0 var(--color-text-primary)",
    "shadow-raised": "6px 6px 0 var(--color-text-primary)",
    "shadow-inset": "inset 2px 2px 5px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "backdrop-blur": "0px",
    "control-height": "2.5rem",
    "space-control-inline": "0.875rem",
    "space-control-block": "0.625rem",
    "space-surface-inline": "1rem",
    "space-surface-block": "1rem",
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-style": "solid",
    "state-hover-transform": "translate(-2px, -2px)",
    "state-active-transform": "translate(1px, 1px)",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "1.75",
    "icon-fill": "none",
    "motion-fast": "100ms",
    "motion-standard": "160ms",
    "motion-slow": "220ms",
    "motion-easing": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-enter": "spring-in",
    "motion-exit": "fade",
    "motion-emphasis": "bounce-once",
    "texture": "none",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
