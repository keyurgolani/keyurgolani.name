  "caveats": ["A test fixture: it registers only when QUALITY_FIXTURES is 1 or meta."],
  "tokens": {
    "surface-material": "linear-gradient(var(--color-surface-default), var(--color-surface-default))",
    "surface-opacity": "100%",
    "radius-control": "8px",
    "radius-card": "14px",
    "radius-overlay": "20px",
    "radius-media": "12px",
    "radius-badge": "999px",
    "border-control": "1px solid var(--color-border-strong)",
    "border-card": "1px solid var(--color-border-default)",
    "border-divider": "1px solid var(--color-border-subtle)",
    "shadow-card": "0 2px 8px color-mix(in srgb, var(--color-text-primary) 12%, transparent)",
    "shadow-overlay": "0 10px 28px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "shadow-raised": "0 10px 28px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "shadow-inset": "inset 2px 2px 5px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "backdrop-blur": "0px",
    "control-height": "2.5rem",
    "space-control-inline": "0.875rem",
    "space-control-block": "0.625rem",
    "space-surface-inline": "1rem",
    "space-surface-block": "1rem",
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-style": "solid",
    "state-hover-transform": "translateY(-1px)",
    "state-active-transform": "scale(0.98)",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "1.75",
    "icon-fill": "none",
    "motion-fast": "100ms",
    "motion-standard": "160ms",
    "motion-slow": "220ms",
    "motion-easing": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-enter": "fade-rise",
    "motion-exit": "fade",
    "motion-emphasis": "pulse-once",
    "texture": "none",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
