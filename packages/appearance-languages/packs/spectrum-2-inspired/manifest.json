{
  "id": "spectrum-2-inspired",
  "name": "Spectrum 2 Inspired",
  "description": "An independent interpretation of Spectrum 2's public design principles: pill buttons, 10px cards, 16px popovers and 8px badges, 2px outlines on fields, cards and rules, flat cards and soft diffuse elevation on popovers, 32px controls with room inside, a 2px ring with a 2px gap, and quick ease-out motion with a press that scales down. It ships no official component, token file, icon, or font.",
  "version": "1.0.6",
  "tokenContract": 1,
  "tier": "stable",
  "family": "product-systems",
  "provenance": {
    "source": {
      "name": "Spectrum 2",
      "url": "https://spectrum.adobe.com/"
    },
    "license": "independent-inspired-interpretation",
    "attribution": "Keyur Golani, after Spectrum 2's public principles. Not affiliated with or endorsed by Adobe.",
    "researchedAt": "2026-10-17",
    "maintainer": "keyurgolani",
    "derivation": "The reviewed prototype's spectrum recipe, with its --appearance-* references read as --color-*, and the contract's signature-fill and emphasis-glow at the fallback language's values."
  },
  "modes": ["light", "dark"],
  "accessibility": {
    "checks": ["contrast", "focus-ring", "stylesheet-lint"]
  },
  "cost": {
    "assets": 0,
    "assetBytes": 0
  },
  "budgets": {
    "js": 0,
    "css": 3072,
    "image": 0,
    "font": 0,
    "animation": 0,
    "enhancement": 0
  },
  "fallbacks": [
    "Under reduced transparency, without backdrop-filter, in forced colors, and in print, surfaces render opaque and the backdrop blur is 0.",
    "Under reduced motion, transforms and emphasis stop and entrances and exits fade; a paused boundary and print are instant."
  ],
  "caveats": [],
  "tokens": {
    "surface-material": "linear-gradient(var(--color-surface-default), var(--color-surface-default))",
    "radius-control": "1rem",
    "radius-card": "10px",
    "radius-overlay": "16px",
    "radius-media": "8px",
    "radius-badge": "8px",
    "border-control": "2px solid var(--color-border-strong)",
    "border-card": "2px solid var(--color-border-subtle)",
    "border-divider": "2px solid var(--color-border-subtle)",
    "shadow-card": "none",
    "shadow-overlay": "0 4px 16px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "shadow-raised": "0 2px 8px color-mix(in srgb, var(--color-text-primary) 15%, transparent)",
    "shadow-inset": "none",
    "surface-opacity": "100%",
    "backdrop-blur": "0px",
    "control-height": "2rem",
    "space-control-inline": "0.875rem",
    "space-control-block": "0.375rem",
    "space-surface-inline": "1.5rem",
    "space-surface-block": "1.25rem",
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-style": "solid",
    "state-hover-transform": "none",
    "state-active-transform": "scale(0.96)",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "1.5",
    "icon-fill": "none",
    "motion-fast": "130ms",
    "motion-standard": "160ms",
    "motion-slow": "300ms",
    "motion-easing": "cubic-bezier(0, 0, 0.4, 1)",
    "motion-enter": "fade",
    "motion-exit": "fade",
    "motion-emphasis": "none",
    "texture": "none",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
