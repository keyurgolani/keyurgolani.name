{
  "id": "neumorphic",
  "name": "Neumorphic",
  "description": "Soft radii, no borders, soft extruded surfaces, comfortable density, inset shadows, fluid motion, and no texture.",
  "version": "1.0.0",
  "tokenContract": 1,
  "tier": "experimental",
  "provenance": {
    "source": {
      "name": "Keyur Golani portfolio platform",
      "url": "https://github.com/keyurgolani/keyurgolani.name"
    },
    "license": "first-party",
    "attribution": "Keyur Golani, for the keyurgolani.name portfolio platform.",
    "researchedAt": "2026-10-17",
    "maintainer": "keyurgolani",
    "derivation": "The reviewed prototype's soft recipe, with its --appearance-* references read as --color-*, and the contract's signature-fill and emphasis-glow at the fallback language's values."
  },
  "modes": ["light", "dark"],
  "accessibility": {
    "checks": ["contrast", "focus-ring", "stylesheet-lint"]
  },
  "cost": {
    "assets": 0,
    "assetBytes": 0
  },
  "budgets": {
    "js": 0,
    "css": 3072,
    "image": 0,
    "font": 0,
    "animation": 0,
    "enhancement": 0
  },
  "fallbacks": [
    "Under reduced transparency, without backdrop-filter, in forced colors, and in print, surfaces render opaque and the backdrop blur is 0.",
    "Under reduced motion, the state transforms are none and motion is instant.",
    "In forced colors, the material is a solid surface, and shadows and texture drop."
  ],
  "caveats": [
    "Controls carry a hairline border the prototype didn't have, so they meet 3:1 non-text contrast."
  ],
  "tokens": {
    "surface-material": "linear-gradient(145deg, var(--color-surface-prominent), var(--color-surface-subtle))",
    "radius-control": "10px",
    "radius-card": "18px",
    "radius-overlay": "24px",
    "radius-media": "16px",
    "radius-badge": "999px",
    "border-control": "1px solid var(--color-border-strong)",
    "border-card": "0 solid",
    "border-divider": "0 solid",
    "shadow-card": "inset 2px 2px 5px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "shadow-overlay": "0 10px 28px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "shadow-raised": "0 2px 8px color-mix(in srgb, var(--color-text-primary) 12%, transparent)",
    "shadow-inset": "inset 2px 2px 5px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "surface-opacity": "100%",
    "backdrop-blur": "0px",
    "control-height": "2.875rem",
    "space-control-inline": "1.125rem",
    "space-control-block": "0.75rem",
    "space-surface-inline": "1.25rem",
    "space-surface-block": "1.25rem",
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-style": "solid",
    "state-hover-transform": "translateY(-2px)",
    "state-active-transform": "scale(0.985)",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "1.5",
    "icon-fill": "none",
    "motion-fast": "140ms",
    "motion-standard": "240ms",
    "motion-slow": "360ms",
    "motion-easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "motion-enter": "fade-rise",
    "motion-exit": "fade",
    "motion-emphasis": "float-once",
    "texture": "none",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
