{
  "id": "platform-neutral",
  "name": "Platform Neutral",
  "description": "The platform's fallback design language: quiet geometry, solid surfaces, strong control borders, low elevation, and no texture.",
  "tokenContract": 1,
  "tier": "stable",
  "provenance": {
    "source": { "name": "Keyur Golani portfolio platform" },
    "license": "first-party",
    "researchedAt": "2026-10-17",
    "maintainer": "keyurgolani",
    "derivation": "The reviewed prototype's neutral recipe: soft radii, hairline borders, solid material, normal density, low elevation, precise motion, no texture, and 1.75 outline icons. Controls take border-strong, and shadows the shadow role."
  },
  "tokens": {
    "surface-material": "linear-gradient(var(--color-surface-default), var(--color-surface-default))",
    "surface-opacity": "100%",
    "radius-control": "10px",
    "radius-card": "18px",
    "radius-overlay": "24px",
    "radius-media": "16px",
    "radius-badge": "999px",
    "border-control": "1px solid var(--color-border-strong)",
    "border-card": "1px solid var(--color-border-default)",
    "border-divider": "1px solid var(--color-border-subtle)",
    "shadow-card": "0 2px 8px color-mix(in srgb, var(--color-shadow) 12%, transparent)",
    "shadow-overlay": "0 10px 28px color-mix(in srgb, var(--color-shadow) 16%, transparent)",
    "shadow-raised": "0 10px 28px color-mix(in srgb, var(--color-shadow) 16%, transparent)",
    "shadow-inset": "inset 2px 2px 5px color-mix(in srgb, var(--color-shadow) 16%, transparent)",
    "backdrop-blur": "0px",
    "control-height": "2.5rem",
    "space-control-inline": "0.875rem",
    "space-control-block": "0.625rem",
    "space-surface-inline": "1rem",
    "space-surface-block": "1rem",
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-style": "solid",
    "state-hover-transform": "translateY(-1px)",
    "state-active-transform": "scale(0.98)",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "1.75",
    "icon-fill": "none",
    "motion-fast": "100ms",
    "motion-standard": "160ms",
    "motion-slow": "220ms",
    "motion-easing": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-enter": "fade-rise",
    "motion-exit": "fade",
    "motion-emphasis": "pulse-once",
    "texture": "none",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
