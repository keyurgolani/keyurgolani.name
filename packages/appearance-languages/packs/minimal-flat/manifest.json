{
  "id": "minimal-flat",
  "name": "Minimal Flat",
  "description": "Square corners, hairline borders, solid surfaces, normal density, no shadows, no motion, and no texture.",
  "version": "1.0.1",
  "tokenContract": 1,
  "tier": "stable",
  "provenance": {
    "source": {
      "name": "Keyur Golani portfolio platform",
      "url": "https://github.com/keyurgolani/keyurgolani.name"
    },
    "license": "first-party",
    "attribution": "Keyur Golani, for the keyurgolani.name portfolio platform.",
    "researchedAt": "2026-10-17",
    "maintainer": "keyurgolani",
    "derivation": "The reviewed prototype's flat recipe, with its --appearance-* references read as --color-*, and the contract's signature-fill and emphasis-glow at the fallback language's values."
  },
  "modes": ["light", "dark"],
  "accessibility": {
    "checks": ["contrast", "focus-ring", "stylesheet-lint"]
  },
  "cost": {
    "assets": 0,
    "assetBytes": 0
  },
  "budgets": {
    "js": 0,
    "css": 3072,
    "image": 0,
    "font": 0,
    "animation": 0,
    "enhancement": 0
  },
  "fallbacks": [
    "Under reduced transparency, without backdrop-filter, in forced colors, and in print, surfaces render opaque and the backdrop blur is 0.",
    "Under reduced motion, transforms and emphasis stop and entrances and exits fade; a paused boundary and print are instant."
  ],
  "caveats": [],
  "tokens": {
    "surface-material": "linear-gradient(var(--color-surface-default), var(--color-surface-default))",
    "radius-control": "0",
    "radius-card": "0",
    "radius-overlay": "0",
    "radius-media": "0",
    "radius-badge": "0",
    "border-control": "1px solid",
    "border-card": "1px solid",
    "border-divider": "1px solid",
    "shadow-card": "none",
    "shadow-overlay": "none",
    "shadow-raised": "none",
    "shadow-inset": "none",
    "surface-opacity": "100%",
    "backdrop-blur": "0px",
    "control-height": "2.5rem",
    "space-control-inline": "0.875rem",
    "space-control-block": "0.625rem",
    "space-surface-inline": "1rem",
    "space-surface-block": "1rem",
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-style": "solid",
    "state-hover-transform": "none",
    "state-active-transform": "none",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "2",
    "icon-fill": "none",
    "motion-fast": "0.01ms",
    "motion-standard": "0.01ms",
    "motion-slow": "0.01ms",
    "motion-easing": "linear",
    "motion-enter": "none",
    "motion-exit": "none",
    "motion-emphasis": "none",
    "texture": "none",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
