{
  "id": "pixel-interface",
  "name": "Pixel Interface",
  "description": "Square pixel corners, heavy raw borders, solid surfaces, compact density, hard offset shadows, stepped motion, and a dither texture.",
  "version": "1.0.0",
  "tokenContract": 1,
  "tier": "experimental",
  "provenance": {
    "source": {
      "name": "Keyur Golani portfolio platform",
      "url": "https://github.com/keyurgolani/keyurgolani.name"
    },
    "license": "first-party",
    "attribution": "Keyur Golani, for the keyurgolani.name portfolio platform.",
    "researchedAt": "2026-10-17",
    "maintainer": "keyurgolani",
    "derivation": "The reviewed prototype's pixel recipe, with its --appearance-* references read as --color-*, and the contract's signature-fill and emphasis-glow at the fallback language's values."
  },
  "modes": ["light", "dark"],
  "accessibility": {
    "checks": ["contrast", "focus-ring", "stylesheet-lint"]
  },
  "cost": {
    "assets": 0,
    "assetBytes": 0
  },
  "budgets": {
    "js": 0,
    "css": 3072,
    "image": 0,
    "font": 0,
    "animation": 0,
    "enhancement": 0
  },
  "fallbacks": [
    "Under reduced transparency, without backdrop-filter, in forced colors, and in print, surfaces render opaque and the backdrop blur is 0.",
    "Under reduced motion, the state transforms are none and motion is instant.",
    "In forced colors, the material is a solid surface, and shadows and texture drop."
  ],
  "caveats": [
    "A decorative gradient texture sits behind surfaces.",
    "Expressive state motion: hovers and presses move more than in a quiet language."
  ],
  "tokens": {
    "surface-material": "linear-gradient(var(--color-surface-default), var(--color-surface-default))",
    "radius-control": "0",
    "radius-card": "0",
    "radius-overlay": "0",
    "radius-media": "0",
    "radius-badge": "0",
    "border-control": "3px solid",
    "border-card": "3px solid",
    "border-divider": "3px solid",
    "shadow-card": "5px 5px 0 var(--color-border-strong)",
    "shadow-overlay": "8px 8px 0 var(--color-border-strong)",
    "shadow-raised": "8px 8px 0 var(--color-border-strong)",
    "shadow-inset": "none",
    "surface-opacity": "100%",
    "backdrop-blur": "0px",
    "control-height": "2rem",
    "space-control-inline": "0.625rem",
    "space-control-block": "0.375rem",
    "space-surface-inline": "0.75rem",
    "space-surface-block": "0.625rem",
    "focus-width": "4px",
    "focus-offset": "3px",
    "focus-style": "solid",
    "state-hover-transform": "translate(-2px, -2px)",
    "state-active-transform": "translate(2px, 2px)",
    "state-selected-emphasis": "3px",
    "state-disabled-opacity": "0.5",
    "state-loading-opacity": "0.7",
    "state-validation-emphasis": "3px",
    "icon-stroke-width": "2",
    "icon-fill": "currentColor",
    "motion-fast": "80ms",
    "motion-standard": "160ms",
    "motion-slow": "240ms",
    "motion-easing": "steps(4, end)",
    "motion-enter": "pixel-in",
    "motion-exit": "pixel-out",
    "motion-emphasis": "blink-once",
    "texture": "radial-gradient(circle, var(--color-border-default) 0 1px, transparent 1px)",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
