{
  "id": "carbon-inspired",
  "name": "Carbon Inspired",
  "description": "An independent interpretation of Carbon's public design principles: tight radii, hairline borders, solid surfaces, compact density, no shadows, precise motion, and a grid texture. It ships no official component, token file, icon, or font.",
  "version": "1.0.0",
  "tokenContract": 1,
  "tier": "stable",
  "provenance": {
    "source": {
      "name": "Carbon",
      "url": "https://carbondesignsystem.com/"
    },
    "license": "independent-inspired-interpretation",
    "attribution": "Keyur Golani, after Carbon's public principles. Not affiliated with or endorsed by IBM.",
    "researchedAt": "2026-10-17",
    "maintainer": "keyurgolani",
    "derivation": "The reviewed prototype's carbon recipe, with its --appearance-* references read as --color-*, and the contract's signature-fill and emphasis-glow at the fallback language's values."
  },
  "modes": ["light", "dark"],
  "accessibility": {
    "checks": ["contrast", "focus-ring", "stylesheet-lint"]
  },
  "cost": {
    "assets": 0,
    "assetBytes": 0
  },
  "budgets": {
    "js": 0,
    "css": 3072,
    "image": 0,
    "font": 0,
    "animation": 0,
    "enhancement": 0
  },
  "fallbacks": [
    "Under reduced transparency, without backdrop-filter, in forced colors, and in print, surfaces render opaque and the backdrop blur is 0.",
    "Under reduced motion, the state transforms are none and motion is instant.",
    "In forced colors, the material is a solid surface, and shadows and texture drop."
  ],
  "caveats": ["A decorative gradient texture sits behind surfaces."],
  "tokens": {
    "surface-material": "linear-gradient(var(--color-surface-default), var(--color-surface-default))",
    "radius-control": "4px",
    "radius-card": "8px",
    "radius-overlay": "10px",
    "radius-media": "6px",
    "radius-badge": "999px",
    "border-control": "1px solid",
    "border-card": "1px solid",
    "border-divider": "1px solid",
    "shadow-card": "none",
    "shadow-overlay": "none",
    "shadow-raised": "none",
    "shadow-inset": "none",
    "surface-opacity": "100%",
    "backdrop-blur": "0px",
    "control-height": "2rem",
    "space-control-inline": "0.625rem",
    "space-control-block": "0.375rem",
    "space-surface-inline": "0.75rem",
    "space-surface-block": "0.625rem",
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-style": "solid",
    "state-hover-transform": "translateY(-1px)",
    "state-active-transform": "scale(0.98)",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "2",
    "icon-fill": "none",
    "motion-fast": "100ms",
    "motion-standard": "160ms",
    "motion-slow": "220ms",
    "motion-easing": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-enter": "fade-rise",
    "motion-exit": "fade",
    "motion-emphasis": "pulse-once",
    "texture": "linear-gradient(var(--color-border-subtle) 1px, transparent 1px), linear-gradient(90deg, var(--color-border-subtle) 1px, transparent 1px)",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
