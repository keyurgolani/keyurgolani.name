{
  "id": "retro-web",
  "name": "Retro Web",
  "description": "Square corners, beveled borders, skeuomorphic surfaces, compact density, inset shadows, no motion, and a dither texture.",
  "version": "1.0.0",
  "tokenContract": 1,
  "tier": "experimental",
  "provenance": {
    "source": {
      "name": "Keyur Golani portfolio platform",
      "url": "https://github.com/keyurgolani/keyurgolani.name"
    },
    "license": "first-party",
    "attribution": "Keyur Golani, for the keyurgolani.name portfolio platform.",
    "researchedAt": "2026-10-17",
    "maintainer": "keyurgolani",
    "derivation": "The reviewed prototype's retro-web recipe, with its --appearance-* references read as --color-*, and the contract's signature-fill and emphasis-glow at the fallback language's values."
  },
  "modes": ["light", "dark"],
  "accessibility": {
    "checks": ["contrast", "focus-ring", "stylesheet-lint"]
  },
  "cost": {
    "assets": 0,
    "assetBytes": 0
  },
  "budgets": {
    "js": 0,
    "css": 3072,
    "image": 0,
    "font": 0,
    "animation": 0,
    "enhancement": 0
  },
  "fallbacks": [
    "Under reduced transparency, without backdrop-filter, in forced colors, and in print, surfaces render opaque and the backdrop blur is 0.",
    "Under reduced motion, the state transforms are none and motion is instant.",
    "In forced colors, the material is a solid surface, and shadows and texture drop."
  ],
  "caveats": ["A decorative gradient texture sits behind surfaces."],
  "tokens": {
    "surface-material": "linear-gradient(180deg, var(--color-surface-prominent), var(--color-surface-default) 48%, var(--color-surface-subtle))",
    "radius-control": "0",
    "radius-card": "0",
    "radius-overlay": "0",
    "radius-media": "0",
    "radius-badge": "0",
    "border-control": "2px outset",
    "border-card": "2px outset",
    "border-divider": "2px groove",
    "shadow-card": "inset 2px 2px 5px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "shadow-overlay": "0 10px 28px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "shadow-raised": "0 2px 8px color-mix(in srgb, var(--color-text-primary) 12%, transparent)",
    "shadow-inset": "inset 2px 2px 5px color-mix(in srgb, var(--color-text-primary) 16%, transparent)",
    "surface-opacity": "100%",
    "backdrop-blur": "0px",
    "control-height": "2rem",
    "space-control-inline": "0.625rem",
    "space-control-block": "0.375rem",
    "space-surface-inline": "0.75rem",
    "space-surface-block": "0.625rem",
    "focus-width": "3px",
    "focus-offset": "3px",
    "focus-style": "solid",
    "state-hover-transform": "none",
    "state-active-transform": "none",
    "state-selected-emphasis": "2px",
    "state-disabled-opacity": "0.45",
    "state-loading-opacity": "0.65",
    "state-validation-emphasis": "2px",
    "icon-stroke-width": "1.5",
    "icon-fill": "currentColor",
    "motion-fast": "0.01ms",
    "motion-standard": "0.01ms",
    "motion-slow": "0.01ms",
    "motion-easing": "linear",
    "motion-enter": "none",
    "motion-exit": "none",
    "motion-emphasis": "none",
    "texture": "radial-gradient(circle, var(--color-border-default) 0 1px, transparent 1px)",
    "signature-fill": "linear-gradient(90deg, var(--color-signature-start), var(--color-signature-end))",
    "emphasis-glow": "none"
  }
}
