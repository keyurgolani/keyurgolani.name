        "decisions": [
          {
            "decision": "Split along the booking flow, not the data model.",
            "rationale": "Bookings were where the incidents were, so that seam paid for itself first.",
            "alternatives": "A shared-database strangler, which would have kept the incidents."
          }
        ],
        "outcomes": "Shipped in three weeks, with the clinics' booking errors down by half in the first month."
