{
  "name": "@portfolio/variant-singular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Singular: one question per screen, six full-viewport panels with one answer and one action each, then the whole record.",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx",
    "./enhancements/pager": "./src/enhancements/pager.ts",
    "./manifest": "./manifest.json",
    "./styles.css": "./src/styles.css",
    "./studio-thumbnail": "./src/studio-thumbnail.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'"
  },
  "portfolio": {
    "kind": "variant",
    "manifest": "./manifest.json"
  },
  "dependencies": {
    "@portfolio/appearance": "workspace:*",
    "@portfolio/kit": "workspace:*",
    "@portfolio/schema": "workspace:*",
    "@portfolio/variant-contract": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
