  "tokenContract": 1,
  "tier": "extended",
  "provenance": {
    "source": {
      "name": "Fontsource",
      "url": "https://fontsource.org"
    },
    "license": "OFL-1.1",
    "attribution": "Fraunces and Newsreader, by their project authors, self-hosted from their pinned npm packages for the keyurgolani.name portfolio platform.",
    "copyright": "Copyright 2020 The Fraunces Project Authors (github.com/undercasetype/Fraunces); Copyright 2020 The Newsreader Project Authors (http://github.com/productiontype/Newsreader)",
    "researchedAt": "2026-10-26",
    "maintainer": "The upstream projects, at the versions fonts.provenance.json pins",
    "derivation": "Role metrics by the platform for the chapters direction (packs-plan §3.2); font files copied unmodified from @fontsource/fraunces 5.3.0 and @fontsource/newsreader 5.3.0, never subset or renamed inside."
  },
