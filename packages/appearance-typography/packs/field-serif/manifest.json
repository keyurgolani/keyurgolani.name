    "researchedAt": "2026-10-26",
    "maintainer": "The upstream projects, at the versions fonts.provenance.json pins",
    "derivation": "Role metrics by the platform for the terra-field direction (packs-plan §3.2); font files copied unmodified from @fontsource/fraunces 5.3.0 and @fontsource-variable/inter 5.3.0, never subset or renamed inside."
  },
