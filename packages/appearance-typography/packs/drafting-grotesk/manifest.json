  "tier": "extended",
  "provenance": {
    "source": {
      "name": "Fontsource, and IBM's own @ibm/plex-mono",
      "url": "https://fontsource.org"
    },
    "license": "OFL-1.1",
    "attribution": "Space Grotesk and IBM Plex Mono, by their project authors, self-hosted from their pinned npm packages for the keyurgolani.name portfolio platform.",
    "copyright": "Copyright 2020 The Space Grotesk Project Authors (https://github.com/floriankarsten/space-grotesk); Copyright © 2017 IBM Corp. with Reserved Font Name \"Plex\"",
    "researchedAt": "2026-10-26",
    "maintainer": "The upstream projects, at the versions fonts.provenance.json pins",
    "derivation": "Role metrics by the platform for the schematic direction (packs-plan §3.2); font files copied unmodified from @fontsource-variable/space-grotesk 5.3.0 and IBM's split WOFF2 in @ibm/plex-mono 2.5.0, never subset or renamed inside."
  },
  "modes": ["light", "dark"],
