  "schemas": {
    "portfolio": {
      "min": 3,
      "max": 3
    },
    "site": {
      "min": 2,
      "max": 2
    }
  },
  "tokenContract": 1,
  "compositionFamily": "document",
  "motionIntent": "subtle",
  "performanceTier": "light",
  "budgets": {
    "js": 1024,
    "css": 10240,
    "image": 61440,
    "font": 0,
    "animation": 0,
    "enhancement": 6144
  },
  "stills": [
    {
      "file": "./stills/1440.webp",
      "width": 1440,
      "height": 900
    },
    {
      "file": "./stills/720.webp",
      "width": 720,
      "height": 450
    }
  ],
  "renderedKinds": [],
