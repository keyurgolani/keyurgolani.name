{
  "id": "acme-ocean",
  "name": "Ocean",
  "promise": "Long-form work laid out like tide charts.",
  "description": "A test composition that uses every field contract 2.0 defines.",
  "author": "Acme Studio",
  "homepage": "https://acme.test/ocean",
  "bestFor": ["Writers", "Researchers"],
  "contract": "2.0",
  "schemas": { "portfolio": { "min": 3, "max": 3 }, "site": { "min": 2, "max": 2 } },
  "tokenContract": 1,
  "compositionFamily": "monograph",
  "motionIntent": "subtle",
  "performanceTier": "light",
  "budgets": { "js": 20480, "css": 8192, "image": 0, "font": 0, "animation": 0, "enhancement": 0 },
  "renderedKinds": ["hero", "works"],
  "unsupportedKinds": ["github"],
  "contentSlots": [
    {
      "id": "lead",
      "label": "Lead story",
      "select": { "control": "leadSection" },
      "level": "recommended",
      "min": 1,
      "max": 1,
      "whenEmpty": { "mode": "omit", "note": "The page opens on the hero instead." }
    },
    {
      "id": "essays",
      "label": "Essays",
      "select": { "kind": "works" },
      "level": "required",
      "min": 1,
      "whenEmpty": { "mode": "keep", "note": "An empty shelf shows until essays exist." }
    },
    {
      "id": "portrait",
      "label": "Portrait",
      "select": { "field": "/identity/avatar" },
      "level": "optional",
      "min": 0,
      "max": 1,
      "whenEmpty": { "mode": "omit", "note": "The masthead shows no portrait." }
    },
    {
      "id": "covers",
      "label": "Work covers",
      "select": { "field": "/works/*/cover" },
      "level": "optional",
      "min": 0,
      "whenEmpty": { "mode": "omit", "note": "Works show as text." }
    }
  ],
  "routes": {
    "home": "bespoke",
    "work": "shared",
    "views": [
      { "id": "chapters", "under": "home", "type": "path", "segment": "chapters/{chapter}" },
      { "id": "notes", "under": "work", "type": "path", "segment": "notes" },
      { "id": "chapter-anchor", "under": "home", "type": "fragment", "segment": "chapter-{chapter}" }
    ]
  },
  "controls": {
    "version": 2,
    "items": [
      {
        "type": "boolean",
        "id": "showIndex",
        "label": "Show the index",
        "description": "Lists every section before the first one.",
        "default": true
      },
      {
        "type": "enum",
        "id": "heroLayout",
        "label": "Hero layout",
        "description": "How the opening spreads across the page.",
        "options": [
          { "value": "wide", "label": "Wide" },
          { "value": "split", "label": "Split" }
        ],
        "default": "wide"
      },
      {
        "type": "integer",
        "id": "columns",
        "label": "Columns",
        "description": "How many columns the archive uses.",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 2
      },
      {
        "type": "contentRef",
        "id": "leadSection",
        "label": "Lead section",
        "description": "The section the page opens on.",
        "kinds": ["works", "evidence"],
        "default": null
      },
      {
        "type": "contentRefList",
        "id": "featured",
        "label": "Featured",
        "description": "Sections pinned above the rest, in order.",
        "min": 0,
        "max": 3,
        "default": []
      }
    ],
    "migrations": [
      {
        "from": 1,
        "to": 2,
        "operations": [
          { "op": "rename", "from": "layout", "to": "heroLayout" },
          { "op": "mapValue", "control": "heroLayout", "map": { "full": "wide" } },
          { "op": "clamp", "control": "columns", "min": 1, "max": 4 },
          { "op": "drop", "control": "legacyFlag" }
        ]
      }
    ]
  },
  "enhancements": [
    {
      "id": "tide-lines",
      "export": "./enhancements/tide-lines",
      "requires": ["motion-allowed", "min-width:768"]
    }
  ],
  "keyBindings": [
    {
      "region": "chapters",
      "keys": ["ArrowLeft", "ArrowRight"],
      "action": "Moves to the previous or next chapter."
    }
  ],
  "visitorControl": { "placement": "header" },
  "textDirection": ["ltr", "rtl"],
  "provenance": {
    "provisional": false,
    "sources": [
      { "source": "Page 8 composition", "disposition": "preserved" },
      {
        "source": "Neon overlay",
        "disposition": "retired",
        "note": "It only recolored, so it moved to the appearance catalog."
      }
    ]
  },
  "recommendedAppearance": "calm-ink"
}
