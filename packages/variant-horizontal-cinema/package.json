{
  "name": "@portfolio/variant-horizontal-cinema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Horizontal Cinema: five finite chapters, each with its media and its evidence, that every input steps through the same way, and the same chapters in a vertical sequence on narrow and touch screens.",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx",
    "./manifest": "./manifest.json",
    "./styles.css": "./src/styles.css",
    "./studio-thumbnail": "./src/studio-thumbnail.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'"
  },
  "portfolio": {
    "kind": "variant",
    "manifest": "./manifest.json"
  },
  "dependencies": {
    "@portfolio/appearance": "workspace:*",
    "@portfolio/kit": "workspace:*",
    "@portfolio/schema": "workspace:*",
    "@portfolio/variant-contract": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
