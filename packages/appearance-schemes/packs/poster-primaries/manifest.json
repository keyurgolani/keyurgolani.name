  "id": "poster-primaries",
  "name": "Poster Primaries",
  "description": "White paper, black ink, and three hues with one job each: yellow prominent surfaces, blue for everything interactive, and red emphasis. Light only.",
  "version": "1.0.2",
  "tokenContract": 1,
  "tier": "extended",
