**/node_modules
**/.next
**/dist
**/build
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/.cache

archive
experiments
.variant-preview
.git
.github
.husky
.vscode
.idea

# Env files at any depth: Next's standalone output copies apps/web/.env and
# apps/web/.env.production into the image.
**/.env
**/.env.*
!**/.env.example

# Personal portfolio data stays out of the image: the six document names, and
# any other portfolio.* such as an old portfolio.toml. Only the examples ship.
config
portfolio.yml
portfolio.yaml
portfolio.json
site.yml
site.yaml
site.json
portfolio.*
!portfolio.example.yml

# Tests, CI, and dev tooling: not part of the build or the runtime.
tests
ci
reports
playwright.config.ts
.dependency-cruiser.cjs
eslint.config.mjs
.prettierrc.json
.prettierignore
.git-blame-ignore-revs
docs
skills

*.log
.DS_Store
