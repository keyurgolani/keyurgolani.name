{
  "name": "@acme/reference",
  "version": "1.0.0",
  "private": true,
  "description": "A third-party variant in the published format, which pnpm test:external-variant packs, installs in a temporary worktree, and removes (#5). Never installed in a release.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "manifest.json",
    "styles.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": "./manifest.json",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./enhancements/badge": {
      "types": "./dist/enhancements/badge.d.ts",
      "default": "./dist/enhancements/badge.js"
    }
  },
  "portfolio": {
    "kind": "variant",
    "manifest": "./manifest.json"
  },
  "peerDependencies": {
    "@portfolio/appearance": "^0.1.0",
    "@portfolio/kit": "^0.1.0",
    "@portfolio/schema": "^0.1.0",
    "@portfolio/variant-contract": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
