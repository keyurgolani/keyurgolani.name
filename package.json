{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.1",
  "description": "Self-hostable portfolio platform with pluggable visual variants",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm --filter @portfolio/web build",
    "start": "pnpm --filter @portfolio/web start",
    "config:validate": "tsx apps/web/scripts/build-registry.ts --modules-only >&2 && tsx apps/web/scripts/config.mjs validate",
    "config:migrate": "tsx apps/web/scripts/build-registry.ts --modules-only >&2 && tsx apps/web/scripts/config.mjs migrate",
    "config:ids-fix": "tsx apps/web/scripts/config.mjs ids-fix",
    "variants:migrate-controls": "tsx apps/web/scripts/build-registry.ts --modules-only >&2 && tsx apps/web/scripts/migrate-controls.ts",
    "owner:hash-password": "node apps/web/bin/owner.mjs hash-password",
    "store": "pnpm --filter @portfolio/web build:registry --modules-only && tsx --conditions=react-server apps/web/scripts/portfolio-store.ts",
    "fixture:reference": "pnpm --filter @portfolio/web build:registry --modules-only && tsx --conditions=react-server apps/web/scripts/reference-fixture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "pnpm -r typecheck && tsc -p tests --noEmit",
    "test": "pnpm -r test && pnpm test:scripts && pnpm test:quality && pnpm test:catalog-plan",
    "test:scripts": "node --test 'ci/**/*.test.mjs' 'skills/**/*.test.mjs' 'tests/harness/**/*.test.mjs' 'tests/quality/**/*.test.mjs'",
    "test:quality": "tsx --test 'tests/quality/**/*.test.ts'",
    "test:catalog-plan": "tsx --test 'tests/catalog/**/*.test.ts'",
    "test:routes": "playwright test --config tests/routes/playwright.config.ts",
    "test:variants": "playwright test --config tests/variants/playwright.config.ts",
    "test:appearance": "playwright test --config tests/appearance/playwright.config.ts",
    "test:catalog": "playwright test --config tests/catalog/playwright.config.ts",
    "test:catalog-static": "tsx tests/catalog/static-smoke.ts",
    "test:catalog-states": "playwright test --config tests/catalog/states.config.ts",
    "test:preview-fixtures": "playwright test --config tests/preview-fixtures/playwright.config.ts",
    "test:external-variant": "node tests/external-variant/run.mjs",
    "test:trace": "node tests/trace/run.mjs",
    "stills": "tsx --conditions=react-server tests/stills/run.ts",
    "test:trace:baseline": "node tests/trace/baseline.mjs",
    "test:shard": "node ci/shards.mjs run",
    "quality:pr": "tsx tests/quality/run.ts pr",
    "quality:full": "tsx tests/quality/run.ts full",
    "quality:merge": "tsx tests/quality/merge.ts",
    "quality:release": "tsx tests/quality/release.ts",
    "quality:checklist": "tsx tests/quality/checklist.ts",
    "quality:fonts": "tsx tests/quality/fonts.ts",
    "check:skills": "node skills/scripts/sync-checks.mjs",
    "check:registry": "node ci/check-registry.mjs",
    "check:variants": "pnpm --filter @portfolio/web check:variants",
    "check:appearance": "pnpm --filter @portfolio/web check:appearance",
    "catalog": "tsx apps/web/scripts/catalog.ts",
    "catalog:generated": "tsx apps/web/scripts/write-generated.ts",
    "catalog:held": "tsx apps/web/scripts/write-held.ts",
    "catalog:lock": "tsx apps/web/scripts/check-appearance-lock.ts",
    "catalog:seed": "node scripts/catalog/seed.mjs",
    "check:deps": "tsx apps/web/scripts/build-registry.ts --modules-only >&2 && depcruise apps packages --config .dependency-cruiser.cjs",
    "check:pins": "node ci/check-pins.mjs",
    "check:workflows": "node ci/check-workflows.mjs",
    "check:source-maps": "node ci/check-source-maps.mjs",
    "check:standalone": "node ci/check-standalone.mjs",
    "check:markdown-pass": "node ci/check-markdown-pass.mjs",
    "check:catalog-build": "node ci/check-catalog-build.mjs",
    "check:studio-chunks": "EXPECT_BUILD=1 tsx --test 'apps/web/src/app/(studio)/_components/studio-entry.test.ts'",
    "check:docs": "node ci/docs-check.mjs",
    "check:links": "node ci/docs-check.mjs --external",
    "check:catalog-provenance": "node ci/check-catalog-provenance.mjs",
    "select-jobs": "node ci/select-jobs.mjs",
    "quality:exceptions": "tsx tests/quality/exceptions.ts",
    "quality:meta": "tsx tests/quality/meta/run.ts",
    "check:budgets": "node ci/check-budgets.mjs",
    "ci:format": "node ci/run.mjs format -- pnpm format:check",
    "ci:lint": "node ci/run.mjs lint -- pnpm lint",
    "ci:typecheck": "node ci/run.mjs typecheck -- pnpm typecheck",
    "ci:skills": "node ci/run.mjs skills -- pnpm check:skills",
    "ci:registry": "node ci/run.mjs registry -- pnpm check:registry",
    "ci:appearance": "node ci/run.mjs appearance -- pnpm check:appearance",
    "ci:deps": "node ci/run.mjs deps -- pnpm check:deps",
    "ci:pins": "node ci/run.mjs pins -- pnpm check:pins",
    "ci:workflows": "node ci/run.mjs workflows -- pnpm check:workflows",
    "ci:unit": "node ci/run.mjs unit -- pnpm test",
    "ci:build": "node ci/run.mjs build -- pnpm build",
    "ci:source-maps": "node ci/run.mjs source-maps -- pnpm check:source-maps",
    "ci:standalone": "node ci/run.mjs standalone -- pnpm check:standalone",
    "ci:markdown-pass": "node ci/run.mjs markdown-pass -- pnpm check:markdown-pass",
    "ci:catalog-build": "node ci/run.mjs catalog-build -- pnpm check:catalog-build",
    "ci:studio-chunks": "node ci/run.mjs studio-chunks -- pnpm check:studio-chunks",
    "ci:budgets": "node ci/run.mjs budgets -- node ci/budgets.mjs",
    "ci:browser": "node ci/run.mjs browser -- playwright test",
    "ci:routes": "node ci/run.mjs routes -- pnpm test:routes",
    "ci:check-variants": "node ci/run.mjs check-variants -- pnpm check:variants",
    "ci:variants": "node ci/run.mjs variants -- pnpm test:variants",
    "ci:appearance-browser": "node ci/run.mjs appearance-browser -- pnpm test:appearance",
    "ci:preview-fixtures-browser": "node ci/run.mjs preview-fixtures-browser -- pnpm test:preview-fixtures",
    "ci:external-variant": "node ci/run.mjs external-variant -- pnpm test:external-variant",
    "ci:docs": "node ci/run.mjs docs -- node ci/docs-check.mjs",
    "ci:links": "node ci/run.mjs links -- node ci/docs-check.mjs --external",
    "ci:catalog-provenance": "node ci/run.mjs catalog-provenance -- node ci/check-catalog-provenance.mjs",
    "ci:quality-pr": "node ci/run.mjs quality-pr -- pnpm quality:pr",
    "ci:quality-pr-verdict": "node ci/run.mjs quality-pr-verdict -- pnpm quality:merge --",
    "ci:quality-meta": "node ci/run.mjs quality-meta -- pnpm quality:meta",
    "ci:quality-full": "node ci/run.mjs quality-full -- pnpm quality:full -- --external-variant",
    "ci:quality-verdict": "node ci/run.mjs quality-verdict -- pnpm quality:merge --",
    "ci:catalog-full": "node ci/run.mjs catalog-full -- pnpm test:catalog",
    "ci:catalog-static": "node ci/run.mjs catalog-static -- pnpm test:catalog-static",
    "ci:catalog-states": "node ci/run.mjs catalog-states -- pnpm test:catalog-states",
    "ci:quality-release": "node ci/run.mjs quality-release -- pnpm quality:release",
    "ci:image": "node ci/run.mjs image -- node ci/image-smoke.mjs",
    "ci:proxy": "node ci/run.mjs proxy -- node ci/proxy-smoke.mjs",
    "ci:security-proxy": "node ci/run.mjs security-proxy -- node ci/test-security-proxy.mjs",
    "ci:demo-origin": "node ci/run.mjs demo-origin -- node ci/demo-origin.mjs",
    "ci:profiles": "node ci/run.mjs profiles -- pnpm smoke:profiles",
    "ci:summary": "node ci/summarize.mjs",
    "smoke:profiles": "node --import tsx ci/smoke-profiles.mjs",
    "clean": "pnpm -r exec rm -rf dist .next node_modules tsconfig.tsbuildinfo && rm -rf node_modules",
    "new-variant": "node skills/variant-developer/scripts/new-variant.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.10.0",
    "@types/pngjs": "6.0.5",
    "ajv": "^8.20.0",
    "dependency-cruiser": "18.6.0",
    "esbuild": "0.27.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "web-vitals": "6.2.3",
    "yaml": "^2.8.4",
    "zod": "3.25.76"
  }
}
