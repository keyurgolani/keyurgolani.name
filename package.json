{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.1",
  "description": "Self-hostable portfolio platform with pluggable visual variants",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm --filter @portfolio/web build",
    "start": "pnpm --filter @portfolio/web start",
    "config:validate": "tsx apps/web/scripts/build-registry.ts >&2 && tsx apps/web/scripts/config.mjs validate",
    "config:migrate": "tsx apps/web/scripts/build-registry.ts >&2 && tsx apps/web/scripts/config.mjs migrate",
    "owner:hash-password": "node apps/web/bin/owner.mjs hash-password",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "pnpm -r typecheck && tsc -p tests --noEmit",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test 'ci/**/*.test.mjs' 'skills/**/*.test.mjs' 'tests/harness/**/*.test.mjs'",
    "check:skills": "node skills/scripts/sync-checks.mjs",
    "check:registry": "node ci/check-registry.mjs",
    "check:variants": "pnpm --filter @portfolio/web check:variants",
    "check:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:pins": "node ci/check-pins.mjs",
    "check:workflows": "node ci/check-workflows.mjs",
    "ci:format": "node ci/run.mjs format -- pnpm format:check",
    "ci:lint": "node ci/run.mjs lint -- pnpm lint",
    "ci:typecheck": "node ci/run.mjs typecheck -- pnpm typecheck",
    "ci:skills": "node ci/run.mjs skills -- pnpm check:skills",
    "ci:registry": "node ci/run.mjs registry -- pnpm check:registry",
    "ci:deps": "node ci/run.mjs deps -- pnpm check:deps",
    "ci:pins": "node ci/run.mjs pins -- pnpm check:pins",
    "ci:workflows": "node ci/run.mjs workflows -- pnpm check:workflows",
    "ci:unit": "node ci/run.mjs unit -- pnpm test",
    "ci:build": "node ci/run.mjs build -- pnpm build",
    "ci:browser": "node ci/run.mjs browser -- playwright test",
    "ci:image": "node ci/run.mjs image -- node ci/image-smoke.mjs",
    "ci:proxy": "node ci/run.mjs proxy -- node ci/proxy-smoke.mjs",
    "ci:summary": "node ci/summarize.mjs",
    "smoke:profiles": "node --import tsx ci/smoke-profiles.mjs",
    "clean": "pnpm -r exec rm -rf dist .next node_modules tsconfig.tsbuildinfo && rm -rf node_modules",
    "new-variant": "node skills/variant-developer/scripts/new-variant.mjs",
    "check-coverage": "node skills/variant-developer/scripts/check-coverage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.4",
    "playwright": "1.58.2",
    "prettier": "3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "yaml": "^2.8.4"
  }
}
