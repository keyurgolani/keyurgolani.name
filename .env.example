# Deployment settings. The server reads these from its environment only, at
# startup, and refuses to start when a required one is missing or invalid.
# docker compose reads the .env file next to the Compose file it runs
# (docker-compose.yml here, deploy/.env for deploy/compose.*.yml); `pnpm dev`
# uses apps/web/.env.development.
#
# Every key also accepts <KEY>_FILE: the path of a file holding the value,
# such as a Docker secret (one trailing newline is trimmed). Set the key or
# its _FILE, not both. An empty value counts as unset.

# Required. Exactly owner, demo, or read-only. owner doesn't start yet.
# PORTFOLIO_PROFILE=read-only

# Required. The origin visitors use: scheme, host, and optional port, no path
# or trailing slash. Every absolute URL (sitemap, robots.txt, feed, social
# cards, structured data) uses it. Under demo it's the demo hostname, such as
# https://demo.jane.name.
# PORTFOLIO_ORIGIN=https://jane.name

# owner and read-only. The directory holding exactly one portfolio.yml (or
# .yaml, .json). Relative paths resolve against apps/web.
# PORTFOLIO_SOURCE_DIR=/config

# All profiles. How many trusted proxies append to X-Forwarded-For. Default 0.
# PORTFOLIO_TRUSTED_PROXY_HOPS=1

# owner and demo. Origin for isolated previews; must differ from PORTFOLIO_ORIGIN.
# PORTFOLIO_PREVIEW_ORIGIN=https://preview.jane.name

# owner only: the writable data directory, where deploy/compose.owner.yml
# mounts a volume, and the Studio password hash, reserved for a later release.
# PORTFOLIO_DATA_DIR=/var/lib/portfolio
# PORTFOLIO_AUTH_PASSWORD_HASH_FILE=/run/secrets/portfolio_auth_password_hash

# owner only. Public GitHub sections never use a token.
# GITHUB_TOKEN_FILE=/run/secrets/github_token

# A key outside its profile's list stops a production server; `pnpm dev` warns
# and ignores it. PORTFOLIO_PATH and NEXT_PUBLIC_BASE_URL were replaced by
# PORTFOLIO_SOURCE_DIR and PORTFOLIO_ORIGIN; setting either stops the server.

# Docker Compose only: the port to publish on 127.0.0.1.
# PORT=3000
