# Deployment settings. The server reads these from its environment only, at
# startup, and refuses to start when a required one is missing or invalid.
# docker compose reads the .env file next to the Compose file it runs
# (docker-compose.yml here, deploy/.env for deploy/compose.*.yml); `pnpm dev`
# uses apps/web/.env.development.
#
# Every key also accepts <KEY>_FILE: the path of a file holding the value,
# such as a Docker secret (one trailing newline is trimmed). Set the key or
# its _FILE, not both. An empty value counts as unset.

# Required. Exactly owner, demo, or read-only. owner also needs
# PORTFOLIO_DATA_DIR and PORTFOLIO_AUTH_PASSWORD_HASH_FILE, below.
# PORTFOLIO_PROFILE=read-only

# Required. The origin visitors use: scheme, host, and optional port, no path
# or trailing slash. Every absolute URL (sitemap, robots.txt, feed, social
# cards, structured data) uses it. Under demo it's the demo hostname, such as
# https://demo.jane.name.
# PORTFOLIO_ORIGIN=https://jane.name

# owner and read-only. The directory holding one portfolio.yml and one
# site.yml (or their .yaml or .json forms). Relative paths resolve against
# apps/web.
# PORTFOLIO_SOURCE_DIR=/config

# All profiles. How many trusted proxies append to X-Forwarded-For. Default 0.
# PORTFOLIO_TRUSTED_PROXY_HOPS=1

# owner and demo. Origin for isolated previews, on another registrable domain
# than PORTFOLIO_ORIGIN, never its host. Unset, frames stay opaque, the safe default.
# PORTFOLIO_PREVIEW_ORIGIN=https://jane-preview.net

# demo only: a read-only mount of a full export (bundle format 1, provisional)
# to serve at /reference. Read once, at startup; a reference that doesn't
# verify leaves the demo on its sample, with a warning. Mount it read-only.
# PORTFOLIO_REFERENCE_DIR=/reference

# owner and read-only: the directory media sources name paths under, such as
# atlas/cover.jpg. The server only reads it: mount it read-only.
# PORTFOLIO_MEDIA_ROOT=/media

# owner only, and required: the writable data directory for sessions, preview
# grants, and the audit log, where deploy/compose.owner.yml mounts a volume.
# PORTFOLIO_DATA_DIR=/var/lib/portfolio

# owner only: the file holding the owner password's scrypt hash, which
# hash-password writes (docs/deployment.md, Owner authentication).
# deploy/compose.owner.yml sets it to /run/secrets/owner_password_hash, its
# owner_password_hash secret. Don't put the hash itself in a .env file:
# Compose reads each $ in it as a variable.
# PORTFOLIO_AUTH_PASSWORD_HASH_FILE=

# owner only: how long a session lasts idle, 5 to 120 minutes
# (default 60), and at most, 1 to 24 hours (default 12).
# PORTFOLIO_AUTH_SESSION_IDLE_MINUTES=
# PORTFOLIO_AUTH_SESSION_MAX_HOURS=

# owner only: how long a preview grant lasts without a renewal from Studio,
# 60 to 3600 seconds (default 900), and at most, 300 to 43200 seconds
# (default 7200), never under the first.
# PORTFOLIO_PREVIEW_GRANT_IDLE_TTL_SECONDS=
# PORTFOLIO_PREVIEW_GRANT_MAX_TTL_SECONDS=

# owner only. Public GitHub sections never use a token.
# GITHUB_TOKEN_FILE=/run/secrets/github_token

# A key outside its profile's list stops a production server; `pnpm dev` warns
# and ignores it. PORTFOLIO_PATH and NEXT_PUBLIC_BASE_URL were replaced by
# PORTFOLIO_SOURCE_DIR and PORTFOLIO_ORIGIN; setting either stops the server.

# Docker Compose only: the port to publish on 127.0.0.1.
# PORT=3000
